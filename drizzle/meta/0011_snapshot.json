          "value": "(\"subscription_intents\".\"attempt_reservation_id\" is null and \"subscription_intents\".\"attempt_reservation_expires_at\" is null)\n          or (\"subscription_intents\".\"status\" = 'open' and \"subscription_intents\".\"attempt_reservation_id\" is not null\n              and \"subscription_intents\".\"attempt_reservation_expires_at\" is not null)"
        }
