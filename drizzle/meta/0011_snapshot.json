          "value": "(\"subscription_intents\".\"status\" in ('legacy', 'open') and \"subscription_intents\".\"winner_attempt_id\" is null)\n          or (\"subscription_intents\".\"status\" in ('won', 'completed') and \"subscription_intents\".\"winner_attempt_id\" is not null)"
        },
        "subscription_intents_reservation_check": {
