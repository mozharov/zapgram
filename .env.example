# Pause external Lightning sends when the LNbits funding-source balance is short.
# on (default): check before POST /api/v1/payments. Internal transfers are not paused.
# Also accepted, any case: true/false, 1/0, yes/no. Any other value logs a warning and stays on.
# off: skip the check. Use this when the funding source is NWC without get_balance.
# That wallet reports balance 0 and an empty funding_source_error, which would
# otherwise pause every external send. Startup then records backend_liquidity_mode
# with mode=disabled and reason=guard_off.
BACKEND_LIQUIDITY_GUARD=on
